# Copy to .env and fill in real values. Never commit .env.

# --- Database ---
POSTGRES_DB=bunited
POSTGRES_USER=bunited
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
ConnectionStrings__Default=Host=localhost;Port=5432;Database=bunited;Username=bunited;Password=change-me

# --- Api container (docker-compose) ---
ASPNETCORE_ENVIRONMENT=Development
API_PORT=8080

# --- Auth ---
Jwt__Issuer=bunited
Jwt__Audience=bunited-clients
# Must be >= 32 bytes (256 bits) for HS256, per RFC 7518 §3.2 — the Api host fails fast at
# startup otherwise. Generate one with:
# pwsh -c "[Convert]::ToBase64String((New-Object byte[] 48 | %{[System.Security.Cryptography.RandomNumberGenerator]::Fill($_); $_}))"
Jwt__SigningKey=change-me-to-a-random-base64-value-at-least-32-bytes-long
Jwt__AccessTokenLifetimeMinutes=15
Jwt__RefreshTokenLifetimeDays=30

# --- Account lockout (Identity module) ---
AccountLockout__MaxFailedAttempts=5
AccountLockout__LockoutDurationMinutes=15

# --- Stripe (Billing module) ---
Stripe__SecretKey=
Stripe__PublishableKey=
Stripe__WebhookSecret=

# --- Video provider (Content module) ---
VideoProvider__Provider=Mux
VideoProvider__ApiKey=
VideoProvider__ApiSecret=

# --- Email (Notifications module) ---
Email__Provider=Smtp
Email__FromAddress=no-reply@example.com
Email__ApiKey=

# --- Object storage (Files module) ---
ObjectStorage__Provider=S3
ObjectStorage__BucketName=
ObjectStorage__AccessKey=
ObjectStorage__SecretKey=

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:5000/api/v1
