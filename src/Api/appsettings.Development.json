{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Cors": {
    "AllowedOrigins": ["http://localhost:5173"]
  },
  "Billing": {
    "GracePeriodDays": 3,
    "DemoWebhookSecret": "dev-only-demo-webhook-secret-not-for-production"
  },
  "RateLimiting": {
    "Auth": {
      "PermitLimit": 20,
      "WindowSeconds": 60
    }
  }
}
